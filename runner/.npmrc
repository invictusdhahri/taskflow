# The runner must install as a fully standalone project, regardless of
# whether the TARGET repo it's checked out alongside (as .taskflow-runner/)
# happens to itself be a pnpm workspace. Without this, pnpm walks upward from
# this directory, finds the target repo's own pnpm-workspace.yaml, and treats
# this package as outside that workspace's declared members — silently
# skipping its install entirely instead of erroring, which is what produced
# "Cannot find package 'tsx'" the first time this was copied into a repo that
# was itself a pnpm workspace.
ignore-workspace=true
