# Required for plan / smoke / matrix / holdout
OPENROUTER_API_KEY=sk-or-v1-...

# Production default is google/gemini-2.5-flash (`pnpm plan`)

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=120000
# OPENROUTER_MAX_RETRIES=1
# OPENROUTER_MAX_TOKENS=4500
# TASKFLOW_MAX_USD_PER_RUN=0.40
# TASKFLOW_SKILL_MAX_CHARS=48000
# TASKFLOW_MAX_EVIDENCE_CHARS=28000
# TASKFLOW_SNAPSHOT_MAX_EVIDENCE_CHARS=180000
# SNAPSHOT_MAX_CODE_FILE_BYTES=120000
# SNAPSHOT_MAX_CODE_TOTAL_BYTES=12000000
